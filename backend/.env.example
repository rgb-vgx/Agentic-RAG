# Environment overrides. Non-secret defaults live in conf/conf.json.
# Keep secrets here (or in the process environment), never in conf.json.

# --- Deployment / infrastructure ---
# docker-compose overrides the service hostnames for these.
# The compose Postgres is published on host port 5436.
DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5436/agentic_rag
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
S3_ENDPOINT_URL=http://localhost:9000

# --- Secrets / credentials ---
QDRANT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RERANK_API_KEY=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Change this before any non-local deployment.
JWT_SECRET=change-me
# Development-only: skip Bearer authentication. Refused when APP_ENV != development.
AUTH_DISABLED=false
# Identity used while AUTH_DISABLED=true.
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_TENANT_ID=00000000-0000-0000-0000-000000000002
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Optional provider endpoints (e.g. a LiteLLM proxy) ---
# Local stack talks to Ollama on the host; both chat and embeddings use this
# URL. Outside Docker use http://localhost:11434/v1 instead.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
ANTHROPIC_BASE_URL=
# Anthropic-compatible proxy (e.g. OpenCode). When ANTHROPIC_AUTH_TOKEN is
# set the SDK sends Authorization: Bearer; otherwise it sends x-api-key.
#   ANTHROPIC_BASE_URL=https://opencode.ai/inference/go/anthropic
#   ANTHROPIC_AUTH_TOKEN=<token>
#   ANTHROPIC_EXTRA_HEADERS={"x-opencode-session":"agentic-rag"}
#   ANTHROPIC_THINKING_TYPE=adaptive
#   ANTHROPIC_OUTPUT_EFFORT=high
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_EXTRA_HEADERS={}

# --- Embeddings (TEI serving Adc05102002/bge-m3-vi-base, 1024 dims) ---
# Inside compose the TEI container is reachable at http://tei:80/v1; outside
# Docker use http://localhost:8080/v1.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=Adc05102002/bge-m3-vi-base
EMBEDDING_DIM=1024
EMBEDDING_BASE_URL=http://tei:80/v1
