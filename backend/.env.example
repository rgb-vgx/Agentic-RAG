# --- Application ---
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL ---
DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5432/agentic_rag

# --- Redis / RQ ---
REDIS_URL=redis://localhost:6379/0
INGESTION_QUEUE=ingestion

# --- Qdrant ---
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=chunks
QDRANT_API_KEY=

# --- Object storage (S3-compatible) ---
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=agentic-rag
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# --- LLM providers ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-sonnet-4-20250514

# --- Embeddings ---
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# --- Reranking ---
RERANK_PROVIDER=cohere
RERANK_MODEL=rerank-multilingual-v3.0
RERANK_API_KEY=

# --- Auth (Google OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=1440

# --- Observability (Langfuse) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3001

# --- Agent limits ---
AGENT_MAX_RETRIEVAL_ITERATIONS=3
AGENT_MAX_DECOMPOSITION_TASKS=5
