# Environment overrides. Non-secret defaults live in conf/conf.json.
# Keep secrets here (or in the process environment), never in conf.json.

# --- Deployment / infrastructure ---
# docker-compose overrides the service hostnames for these.
# The compose Postgres is published on host port 5436.
DATABASE_URL=postgresql+asyncpg://agentic:agentic@localhost:5436/agentic_rag
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
S3_ENDPOINT_URL=http://localhost:9000

# --- Secrets / credentials ---
QDRANT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
RERANK_API_KEY=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match the Authorized redirect URI in the Google OAuth client.
GOOGLE_REDIRECT_URI=https://rag.thuyetmt.io.vn/auth/callback
# Change this before any non-local deployment.
JWT_SECRET=change-me
# Optional; when empty, a key is derived from JWT_SECRET.
INTEGRATION_ENCRYPTION_KEY=
# Comma-separated verified Google emails allowed to create their own
# user/membership on first login. Everyone else remains invite-only.
AUTH_BOOTSTRAP_EMAILS=
# Optional tenant for bootstrapped users (defaults to DEV_TENANT_ID).
AUTH_BOOTSTRAP_TENANT_ID=
# Persist LangGraph checkpoints in Postgres (durable run state).
LANGGRAPH_CHECKPOINTING=false
# Development-only: skip Bearer authentication. Refused when APP_ENV != development.
AUTH_DISABLED=false
# Identity used while AUTH_DISABLED=true.
DEV_USER_ID=00000000-0000-0000-0000-000000000001
DEV_TENANT_ID=00000000-0000-0000-0000-000000000002
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# --- Optional provider endpoints (e.g. a LiteLLM proxy) ---
# Local stack talks to Ollama on the host; both chat and embeddings use this
# URL. Outside Docker use http://localhost:11434/v1 instead.
OPENAI_BASE_URL=http://host.docker.internal:11434/v1
ANTHROPIC_BASE_URL=
# Anthropic-compatible proxy (e.g. OpenCode). When ANTHROPIC_AUTH_TOKEN is
# set the SDK sends Authorization: Bearer; otherwise it sends x-api-key.
#   ANTHROPIC_BASE_URL=https://opencode.ai/inference/go/anthropic
#   ANTHROPIC_AUTH_TOKEN=<token>
#   ANTHROPIC_EXTRA_HEADERS={"x-opencode-session":"agentic-rag"}
#   ANTHROPIC_THINKING_TYPE=adaptive
#   ANTHROPIC_OUTPUT_EFFORT=high
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_EXTRA_HEADERS={}

# --- Embeddings (default: Ollama qwen3-embedding:8b, 4096 dims) ---
# Alternatives: bge-m3 (1024 dims, fastest) or TEI
# Adc05102002/bge-m3-vi-base at http://tei:80/v1.
# Switch with ./control.sh embeddings <qwen3|ollama|tei>.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=qwen3-embedding:8b
EMBEDDING_DIM=4096
EMBEDDING_BASE_URL=http://host.docker.internal:11434/v1
# Prepended to queries only, never to documents.
EMBEDDING_QUERY_INSTRUCTION=Given a Vietnamese question, retrieve passages that answer the question
# Large models are slow per request: small batches, long timeout.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SECONDS=900

# --- Reranker (Qwen3-Reranker-4B scoring service) ---
# Set RERANK_ENABLED=false for dense-only retrieval (top-1 drops slightly).
RERANK_ENABLED=true
# Inside compose the service is reachable at http://reranker:8000.
RERANK_URL=http://localhost:8083
RERANK_PATH=/rerank
