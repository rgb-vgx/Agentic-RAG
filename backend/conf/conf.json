{
  "app_env": "development",
  "app_debug": false,
  "api_v1_prefix": "/api/v1",
  "cors_origins": ["http://localhost:3000"],

  "database_url": "postgresql+asyncpg://agentic:agentic@localhost:5436/agentic_rag",

  "redis_url": "redis://localhost:6379/0",
  "ingestion_queue": "ingestion",

  "qdrant_url": "http://localhost:6333",
  "qdrant_collection": "chunks_vi",

  "s3_endpoint_url": "http://localhost:9000",
  "s3_bucket": "agentic-rag",
  "s3_region": "us-east-1",

  "llm_provider": "openai",
  "openai_chat_model": "qwen3.5:9b",
  "openai_reasoning_effort": "none",
  "anthropic_chat_model": "claude-sonnet-4-20250514",
  "llm_default_model": "qwen3.5:9b",
  "llm_models": [
    {"id": "qwen3.5:9b", "label": "Qwen3.5 9B (Ollama)", "provider": "openai"},
    {
      "id": "deepseek-v4.1-flash",
      "label": "DeepSeek v4.1 Flash (OpenCode)",
      "provider": "anthropic"
    }
  ],

  "embedding_provider": "openai",
  "embedding_model": "Adc05102002/bge-m3-vi-base",
  "embedding_dim": 1024,

  "rerank_provider": "cohere",
  "rerank_model": "rerank-multilingual-v3.0",

  "jwt_issuer": "rag-api",
  "jwt_audience": "rag-web",
  "jwt_access_ttl_seconds": 900,
  "auth_revocation_ttl_seconds": 60,
  "auth_disabled": false,

  "langfuse_enabled": false,
  "langfuse_host": "http://localhost:3001",

  "agent_max_retrieval_iterations": 3,
  "agent_max_decomposition_tasks": 5
}
