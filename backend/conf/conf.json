{
  "app_env": "development",
  "app_debug": false,
  "api_v1_prefix": "/api/v1",
  "cors_origins": ["http://localhost:3000"],

  "database_url": "postgresql+asyncpg://agentic:agentic@localhost:5436/agentic_rag",

  "redis_url": "redis://localhost:6379/0",
  "ingestion_queue": "ingestion",

  "qdrant_url": "http://localhost:6333",
  "qdrant_collection": "chunks_qwen3_8b",
  "retrieval_enable_sparse": false,
  "qdrant_timeout_seconds": 120,

  "s3_endpoint_url": "http://localhost:9000",
  "s3_bucket": "agentic-rag",
  "s3_region": "us-east-1",

  "llm_provider": "anthropic",
  "openai_chat_model": "qwen3.5:9b",
  "openai_reasoning_effort": "none",
  "anthropic_chat_model": "claude-sonnet-4-20250514",
  "llm_default_model": "deepseek-v4.1-flash",
  "llm_models": [
    {
      "id": "deepseek-v4.1-flash",
      "label": "DeepSeek v4.1 Flash (OpenCode)",
      "provider": "anthropic"
    }
  ],

  "embedding_provider": "openai",
  "embedding_model": "qwen3-embedding:8b",
  "embedding_dim": 4096,
  "embedding_base_url": "http://localhost:11434/v1",
  "embedding_query_instruction": "Given a Vietnamese question, retrieve passages that answer the question",
  "embedding_batch_size": 16,
  "embedding_timeout_seconds": 900,

  "rerank_provider": "llamacpp",
  "rerank_model": "Qwen3-Reranker-4B",
  "rerank_enabled": true,
  "rerank_url": "http://localhost:8083",
  "rerank_path": "/rerank",
  "rerank_candidates": 50,
  "rerank_top_n": 10,

  "jwt_issuer": "rag-api",
  "jwt_audience": "rag-web",
  "jwt_access_ttl_seconds": 900,
  "auth_revocation_ttl_seconds": 60,
  "auth_disabled": false,

  "langfuse_enabled": false,
  "langfuse_host": "http://localhost:3001",

  "agent_max_retrieval_iterations": 3,
  "agent_max_decomposition_tasks": 5,
  "synthesis_max_evidence_per_group": 8
}
